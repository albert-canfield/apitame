{
  "name": "apitame",
  "version": "0.2.0",
  "description": "Turn an OpenAPI spec or a SQL database into a safe, curated MCP server plus agent skills. One command.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "postgres",
    "sqlite",
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "cursor",
    "cli"
  ],
  "homepage": "https://github.com/albert-canfield/apitame#readme",
  "bugs": {
    "url": "https://github.com/albert-canfield/apitame/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albert-canfield/apitame.git"
  },
  "license": "MIT",
  "author": "Albert Canfield (https://github.com/albert-canfield)",
  "type": "module",
  "bin": {
    "apitame": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@readme/openapi-parser": "^9.1.0",
    "ajv": "^8.20.0",
    "commander": "^14.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "node-sql-parser": "5.4.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
