# Copy to .env and fill in. apitame loads .env from the folder that holds apitame.config.yaml.
# Never commit real values.

# OpenAPI sources
# PETSTORE_API_KEY=
# GITHUB_TOKEN=

# OAuth2 client credentials
# MY_API_CLIENT_ID=
# MY_API_CLIENT_SECRET=

# SQL sources (use a read-only role)
# DATABASE_URL=postgres://apitame_ro:password@localhost:5432/shop

# Streamable HTTP transport: required when binding to a non-loopback host
# APITAME_HTTP_TOKEN=
